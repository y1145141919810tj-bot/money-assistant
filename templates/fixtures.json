    {
      "id": "unrelated-app-not-flow",
      "source": "notif",
      "origin": "com.example.shopping",
      "title": "促销",
      "text": "满100.00元减20元，立即支付",
      "postedAt": 1785904200000,
      "expect": {
        "status": "not_flow",
        "amountCents": null
      }
    }
  ]
}
