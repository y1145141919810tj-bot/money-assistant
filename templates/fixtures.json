{
  "version": 1,
  "note": "设备端(Kotlin)与云端(Node)共用的解析验收语料。两个实现必须对同一份 case 得出相同结论，任何一边失配即失败——这是防止两处解析器漂移的唯一手段。字段缺省表示不校验该字段。",
  "cases": [
    {
      "id": "icbc-expense",
      "source": "sms",
      "origin": "95588",
      "text": "【工商银行】您尾号1234的储蓄卡账户8月5日12:30支出(消费)人民币100.00元，余额1234.56元。",
      "postedAt": 1785904200000,
      "expect": {
        "status": "parsed",
        "kind": "expense",
        "amountCents": 10000,
        "balanceCents": 123456,
        "accountTail": "1234",
        "channel": "工商银行",
        "templateId": "bank-tail-flow"
      }
    },
    {
      "id": "ccb-expense-chinese-time",
      "source": "sms",
      "origin": "95533",
      "text": "【建设银行】您尾号1234的储蓄卡账户8月5日12时30分快捷支付支出(消费)人民币100.00元，余额1234.56元。",
      "postedAt": 1785904200000,
      "expect": {
        "status": "parsed",
        "kind": "expense",
        "amountCents": 10000,
        "channel": "建设银行"
      }
    },
    {
      "id": "cmb-account-expense",
      "source": "sms",
      "origin": "95555",
      "text": "【招商银行】您账户1234于8月5日12:30支出人民币100.00元，余额1234.56元。",
      "postedAt": 1785904200000,
      "expect": {
        "status": "parsed",
        "kind": "expense",
        "amountCents": 10000,
        "accountTail": "1234",
        "channel": "招商银行",
        "templateId": "bank-account-flow"
      }
    },
    {
      "id": "income-salary",
      "source": "sms",
      "origin": "95588",
      "text": "【工商银行】您尾号1234的储蓄卡账户8月5日12:30收入(工资)人民币1000.00元，余额2234.56元。",
      "postedAt": 1785904200000,
      "expect": {
        "status": "parsed",
        "kind": "income",
        "amountCents": 100000,
        "memo": "工资"
      }
    },
    {
      "id": "refund",
      "source": "sms",
      "origin": "95588",
      "text": "您尾号1234的储蓄卡账户8月5日12:30退款(退货)人民币100.00元。",
      "postedAt": 1785904200000,
      "expect": {
        "status": "parsed",
        "kind": "refund",
        "amountCents": 10000
      }
    },
    {
      "id": "fullwidth-and-thousands",
      "source": "sms",
      "origin": "95588",
      "text": "您尾号1234的储蓄卡账户8月5日12:30支出（消费）人民币1,234.56元",
      "postedAt": 1785904200000,
      "expect": {
        "status": "parsed",
        "kind": "expense",
        "amountCents": 123456
      }
